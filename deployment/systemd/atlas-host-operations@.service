[Unit]
Description=Atlas structured privileged host operations (connection %i)
Documentation=file:///opt/atlas-v5/app/docs/27-host-operations.md
CollectMode=inactive-or-failed

[Service]
User=root
Group=root
Environment=ATLAS_HOST_SCOPES_FILE=/var/lib/atlas-v5/control/host-scopes.json
ExecStart=/usr/bin/python3 /opt/atlas-v5/bin/atlas_host_operations_server.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=1200
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
