ATLAS_ENVIRONMENT=production
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8086
ATLAS_DATABASE_URL_FILE=/etc/atlas-v5/secrets/database-url
ATLAS_STATE_DIR=/var/lib/atlas-v5
ATLAS_ARTIFACT_DIR=/var/lib/atlas-v5/artifacts
ATLAS_SECRET_DIR=/etc/atlas-v5/secrets
ATLAS_FRONTEND_DIST=/opt/atlas-v5/app/frontend/dist
ATLAS_AUTH_REQUIRED=true
ATLAS_AUTH_RP_ID=atlas-agentic.co.za
ATLAS_AUTH_RP_NAME=Atlas V5
ATLAS_AUTH_ORIGIN=https://atlas-agentic.co.za
ATLAS_AUTH_SESSION_HOURS=24
ATLAS_AUTH_ENROLLMENT_CODE_FILE=/var/lib/atlas-v5/auth/enrollment-code
ATLAS_AUTH_ENROLLED_MARKER_FILE=/var/lib/atlas-v5/auth/enrolled
ATLAS_OPENAI_API_KEY_FILE=/etc/atlas-v5/secrets/openai-api-key
ATLAS_OPENAI_MODEL=gpt-5.6-sol
ATLAS_WORKSPACE_ROOT=/var/lib/atlas-v5/workspace
ATLAS_WORKSPACE_DISPLAY_ROOT=/home/jaco/Workspace
ATLAS_GWS_COMMAND=/opt/atlas-v5/bin/gws
ATLAS_GWS_CREDENTIALS_FILE=/etc/atlas-v5/secrets/google-workspace-authorized-user.json
ATLAS_GWS_CONFIG_DIR=/var/lib/atlas-v5/google-workspace/config
ATLAS_GWS_WORKSPACE_DIR=/var/lib/atlas-v5/google-workspace/workspace

ATLAS_GITHUB_MCP_COMMAND=/opt/atlas-v5/bin/github-mcp-server
ATLAS_GITHUB_TOKEN_FILE=/etc/atlas-v5/secrets/github-token
ATLAS_GITHUB_MCP_TOOLSETS=repos,git,pull_requests,issues

ATLAS_PROJECTS_ROOT=/var/lib/atlas-v5/projects
ATLAS_PROJECTS_DISPLAY_ROOT=/home/jaco/Projects
ATLAS_PROJECT_CHECKPOINT_ROOT=/var/lib/atlas-v5/project-checkpoints
ATLAS_GITHUB_OWNER=Keeladin

ATLAS_OWNER_TIMEZONE=Africa/Johannesburg
ATLAS_SCHEDULER_ENABLED=true
ATLAS_SCHEDULER_POLL_SECONDS=30
ATLAS_ACTION_RECONCILE_SECONDS=60
ATLAS_ACTION_STALE_AFTER_SECONDS=300

# Candidate-driven memory reconciliation is bounded and background-only.
ATLAS_MEMORY_RECONCILIATION_ENABLED=true
ATLAS_MEMORY_RECONCILIATION_BATCH_SIZE=8
ATLAS_MEMORY_RECONCILIATION_LEASE_SECONDS=180
ATLAS_MEMORY_RECONCILIATION_MAX_ATTEMPTS=3
ATLAS_MEMORY_SHORT_TERM_REVIEW_HOURS=24
ATLAS_MEMORY_SHORT_TERM_EXPIRY_DAYS=14

ATLAS_CAPABILITY_CALL_LIMIT=16
ATLAS_CAPABILITY_COMPLETION_RESERVE=2
